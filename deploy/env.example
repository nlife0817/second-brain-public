# Шаблон deploy/.env — скопируйте и заполните:
#   cp env.example .env && chmod 600 .env
# Файл .env в git не попадает (см. .gitignore) и остаётся только на сервере.

# ---- Домен и TLS ------------------------------------------------------------
# Домен, на который указывает A-запись сервера. Caddy получит для него сертификат.
APP_DOMAIN=brain.example.com
# Тот же домен со схемой. Уходит в NEXT_PUBLIC_APP_URL при сборке образа —
# по нему строятся ссылки в письмах-приглашениях и в push-уведомлениях.
APP_URL=https://brain.example.com
# Адрес для уведомлений Let's Encrypt об истечении сертификата.
ACME_EMAIL=you@example.com

# ---- База -------------------------------------------------------------------
# DATABASE_URL приложению собирает docker-compose из этих трёх значений.
POSTGRES_USER=secondbrain
POSTGRES_PASSWORD=
POSTGRES_DB=secondbrain

# ---- Подключение Google Calendar (необязательно) ----------------------------
# Вход в приложение идёт по email и паролю и Google не требует. Эти переменные
# нужны только для подключения внешних календарей — без них работает всё,
# кроме кнопки «Подключить Google Calendar».
#
# console.cloud.google.com → Credentials → OAuth client ID → Web application.
# Authorized redirect URI: https://<APP_DOMAIN>/auth/calendar/callback
# Плюс включённый Google Calendar API в проекте и скоуп
# .../auth/calendar.readonly на экране согласия.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Ключ подписи cookie сессии. Сгенерировать:
#   openssl rand -base64 48
# Смена ключа разлогинивает всех — это же и способ отозвать все сессии разом.
SESSION_SECRET=
# Ключ шифрования доступа к внешним календарям: refresh-токен Google и приватная
# ссылка ICS-подписки. Ровно 32 байта. Сгенерировать:
#   openssl rand -hex 32
# Зачем: содержимое core уезжает в ночной дамп, а refresh-токен даёт доступ к
# чужому календарю бессрочно и сам собой не «переподписывается». Смена ключа
# требует переподключить календари заново — сами события восстановит синк.
# Без переменной календарь задач работает, а внешние календари подключить нельзя.
CALENDAR_TOKEN_KEY=
# Здесь была переменная ADMIN_BOOTSTRAP_EMAIL: предполагалось, что указанный
# email становится администратором, когда таблица users пуста. Такого механизма
# в коде нет и не будет — членство резолвится по core.users, а переменная
# окружения не должна раздавать права. На чистой установке первого участника
# заводят в базе руками, пароль ему выдаёт `deploy/password-link.sh <email>`.

# ---- Push-уведомления -------------------------------------------------------
# При смене ключей все текущие подписки браузеров становятся недействительными:
# существующую пару перенесите как есть.
# Новая пара (только для чистой установки): npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Telegram-бот (необязательно) -------------------------------------------
# Второй канал доставки тех же уведомлений, что уходят в push. Без токена канал
# просто выключен: приложение не ходит в Bot API и показывает в настройках
# «бот не настроен на сервере».
#
# Токен выдаёт @BotFather (/newbot или /token у существующего бота). Он же —
# способ писать от имени бота кому угодно, поэтому живёт только здесь; утёкший
# перевыпускается через /revoke.
TELEGRAM_BOT_TOKEN=
# Секрет, которым телеграм подписывает свои запросы к /api/v2/telegram/webhook
# (заголовок X-Telegram-Bot-Api-Secret-Token). Путь публичный — сессии у
# телеграма нет, — и без секрета «привяжи мой чат» смог бы прислать кто угодно.
# Сгенерировать: openssl rand -hex 32
# После заполнения зарегистрируйте вебхук: deploy/telegram-webhook.sh
TELEGRAM_WEBHOOK_SECRET=
# SOCKS5-прокси для исходящих запросов к Bot API — нужен там, откуда
# api.telegram.org недоступен напрямую. Ровно наш случай: провайдер не
# пропускает его IPv4, хост спасается своим IPv6, а у контейнера IPv6 нет.
# Формат: socks5h://[логин:пароль@]хост:порт — именно socks5h, чтобы имя
# резолвил прокси: разрешать его у себя бессмысленно, мы получим тот же
# заблокированный адрес. Пусто — ходим напрямую.
TELEGRAM_PROXY_URL=

# ---- Служебное --------------------------------------------------------------
# Bearer-токен для /api/v2/cron и остальных фоновых эндпоинтов. Тот же секрет
# читает контейнер cron. Сгенерировать: openssl rand -hex 32
CRON_SECRET=
