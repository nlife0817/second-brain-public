# Расписания приложения. Время — UTC (Новосибирск = UTC+7).
# Заменяет pg_cron из миграций 0005 / 0008 / 0027: секрет теперь в .env,
# а не в Supabase Vault, и запрос идёт напрямую в контейнер app, минуя Caddy.
#
# После правки: docker compose build cron && docker compose up -d cron

# --- v2: активно ------------------------------------------------------------
# Страховка мгновенных пушей + материализация повторов, закрытие забытых
# таймеров, доставка вебхуков. Основную доставку делает after() в withOrg.
*/10 * * * * . /etc/cron-env; curl -fsS -m 60 -X POST -H "Authorization: Bearer $CRON_SECRET" "$INTERNAL_URL/api/v2/cron" > /proc/1/fd/1 2>&1

